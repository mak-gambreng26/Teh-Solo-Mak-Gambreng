# Base URL of the deployed app, used to build SPG links and QR codes
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Owner login configuration (required in production)
OWNER_ACCESS_CODE=replace-with-owner-code
AUTH_SECRET=replace-with-a-long-random-secret

# Placeholder — wire up when a real backend replaces the mock services in src/services/mock/*
NEXT_PUBLIC_API_BASE_URL=
